<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_depth_lidar">
    <include merge="true">
      <uri>model://x500_depth</uri>
    </include>
    <!-- Top-mounted 16-beam lidar, matching the common VLP-16 pattern:
         360 deg horizontal, +/-15 deg vertical, 100 m range. -->
    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.09 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0008</ixx>
          <iyy>0.0008</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry><cylinder><radius>0.052</radius><length>0.072</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.13 0.15 1</ambient>
          <diffuse>0.12 0.13 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="housing">
        <geometry><cylinder><radius>0.052</radius><length>0.072</length></cylinder></geometry>
      </collision>
      <sensor name="lidar_3d" type="gpu_lidar">
        <always_on>1</always_on>
        <!-- Ray drawing in the Gazebo GUI stalls the desktop GPU. View the cloud in RViz. -->
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>lidar</topic>
        <pose>0 0 0 0 0 0</pose>
        <gz_frame_id>lidar_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.8</min>
            <max>100.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose relative_to="base_link">0 0 0.09 0 0 0</pose>
    </joint>
  </model>
</sdf>
